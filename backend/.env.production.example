APP_NAME="Travel ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=travel_erp
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=your-domain.example,www.your-domain.example
TRUSTED_PROXIES=*

CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_LEVEL=warning

# Set only for initial seed, then remove or rotate
SEED_USER_PASSWORD=
