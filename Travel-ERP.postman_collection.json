      "value": "1"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Travel ERP — sync session CSRF + attach header on mutating requests",
          "function syncXsrfFromCookies() {",
          "  const raw = pm.cookies.get('XSRF-TOKEN');",
          "  if (raw) pm.collectionVariables.set('xsrf_token', decodeURIComponent(raw));",
          "}",
          "syncXsrfFromCookies();",
          "",
          "const method = pm.request.method;",
          "const path = pm.request.url.getPath();",
          "const mutating = ['POST', 'PUT', 'PATCH', 'DELETE'].includes(method);",
          "const csrfExempt = path.endsWith('/api/login') || path.endsWith('/api/logout');",
          "",
          "if (mutating && !csrfExempt) {",
          "  const xsrf = pm.collectionVariables.get('xsrf_token');",
          "  if (!xsrf) {",
          "    console.warn('xsrf_token فارغ — شغّل Get CSRF ثم Login ثم Refresh CSRF بعد تسجيل الدخول');",
          "  } else {",
          "    pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: xsrf });",
          "  }",
          "}"
        ],
        "type": "text/javascript"
      }
    },
    {
      "listen": "test",
      "script": {
        "exec": [
          "if (['POST','PUT','PATCH','DELETE'].includes(pm.request.method)) {",
          "  pm.test('ليس 401 (جلسة)', () => pm.expect(pm.response.code).to.not.eql(401));",
          "  pm.test('ليس 419 (CSRF)', () => pm.expect(pm.response.code).to.not.eql(419));",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ],
