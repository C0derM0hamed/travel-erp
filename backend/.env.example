APP_NAME="Travel ERP"
APP_ENV=local
APP_KEY=
# Production must keep APP_DEBUG=false and APP_URL on the public HTTPS URL.
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production: use MySQL/MariaDB (see DEPLOYMENT.md). SQLite is for automated tests only.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=travel_erp
DB_USERNAME=travel_erp
DB_PASSWORD=travel_erp

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave empty so cookies bind to the current host (localhost or Cloudflare Tunnel).
SESSION_DOMAIN=
# Omit or leave empty to auto-enable Secure cookies on HTTPS requests (tunnel/production).
SESSION_SECURE_COOKIE=

# Optional extra hosts (host:port only, no https://). The current request host is always allowed.
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8080,localhost:8080
# Cloudflare Tunnel / reverse proxy: trust forwarded protocol and host (use proxy IPs in production).
TRUSTED_PROXIES=*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SEED_USER_PASSWORD=
